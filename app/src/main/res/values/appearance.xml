<resources>
    <style name="AppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:colorAccent">#245DC1</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F8F9FC</item>
        <item name="android:statusBarColor">#F8F9FC</item>
        <item name="android:navigationBarColor">#F8F9FC</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:colorAccent">#91B7FF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#181B20</item>
        <item name="android:statusBarColor">#181B20</item>
        <item name="android:navigationBarColor">#181B20</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
