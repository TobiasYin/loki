  "manualReview": {
    "fish": {
      "passed": false,
      "coreDecisionPassed": true,
      "currentBambooConstraintPassed": true,
      "findings": [
        {
          "excerpt": "雨天正好也是钓 Shad / Tiger Trout 的好时机，可以一起留意。",
          "issue": "该场景为春季且没有魔法鱼饵；Tiger Trout 的普通出现季节是秋、冬。属于超出当前专题资料后的错误扩展。",
          "source": "https://stardewvalleywiki.com/Tiger_Trout"
        },
        {
          "excerpt": "Trap Bobber 属于 tackle，只有 Iridium Rod 能装，且需钓鱼等级 6",
          "issue": "当前竹竿不能装钓具的结论正确，但附加表述仍混淆了常规购买/制作解锁与持有后装备条件；独立装备题另测。",
          "source": "https://stardewvalleywiki.com/Tackle"
        }
      ]
    },
    "crops": {
      "passed": false,
      "coreDecisionPassed": true,
      "findings": [
        {
          "excerpt": "若中途出现非随机商店途径（如旅行商车）再考虑提前完成。",
          "issue": "旅行货车销售属于随机途径，且问题已经明确排除随机商店；主结论春19来不及正确，附加建议违反题设。",
          "source": "https://stardewvalleywiki.com/Traveling_Cart"
        },
        {
          "excerpt": "Speed-Gro 是完成本 Bundle 才给的奖励，属循环依赖，用不上",
          "issue": "完成 Bundle 会给奖励，不代表只能通过该奖励获得；本题已排除肥料，无需自行扩展这个错误的获得限制。",
          "source": "https://stardewvalleywiki.com/Speed-Gro"
        }
      ]
    },
    "equipment": {
      "passed": true,
      "coreDecisionPassed": true,
      "findings": [],
      "qualification": "针对已实际持有 Iridium Rod 和 Trap Bobber 的场景，回答能装、单个 tackle 槽位及购买/制作与装备条件的区分正确。",
